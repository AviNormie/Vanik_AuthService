generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app_auth"]
}

model User {
  id          String @id @default(cuid())
  phoneNumber String @unique
  name        String?
  role        String @default("FARMER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("app_auth")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  @@schema("app_auth")
}

model CreditBalance {
  id       String @id @default(cuid())
  userId   String @unique
  balance  Int    @default(0)
  currency String @default("CREDITS")

  @@schema("app_auth")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@schema("app_auth")
}

model FarmerProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  languagePref String?
  location     String?
  gpsLat       Float?
  gpsLong      Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("app_auth")
}

model OTPStore {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  otp         String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@schema("app_auth")
}
